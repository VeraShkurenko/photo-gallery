[Unit]
Description=Gallery (Flask + gunicorn) on port 80
Wants=network-online.target
After=network-online.target

[Service]
User=gallery
Group=gallery
WorkingDirectory=/opt/gallery
# секрети читає systemd (root) з файлу 600 і передає процесу як змінні оточення
EnvironmentFile=/etc/gallery.env
ExecStart=/opt/gallery/.venv/bin/gunicorn --workers 3 --bind 0.0.0.0:80 --access-logfile - wsgi:app
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
